# PRism environment variables (EXAMPLE, fake values only).
# Copy this file to `.env` and fill in your own real values by hand.
# `.env` is git-ignored. Never commit it, and never paste real secrets into chat or Slack.
# Hosting, database and LLM all run on Vultr (see docs/ARCHITECTURE.md).

# --- GitHub App (Om creates the app and shares the non-secret values) ---
GITHUB_APP_ID=123456
# Path to the .pem private key downloaded from the GitHub App settings page.
# Keep it outside the repo or in ./secrets/ (git-ignored).
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem
# The webhook secret you type into the GitHub App settings. Any long random string.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# The repo where you open fake PRs, as owner/name.
GITHUB_TEST_REPO=your-username/prism-test-repo

# --- smee.io (forwards GitHub webhooks to your laptop, local dev only) ---
SMEE_URL=https://smee.io/your-channel-id

# --- Vultr Serverless Inference (OpenAI-compatible API) ---
# Check the Vultr docs for the current base URL and model names before filling these in.
VULTR_INFERENCE_API_KEY=fake-not-a-real-key
VULTR_INFERENCE_BASE_URL=https://example-check-vultr-docs/v1
VULTR_CHAT_MODEL=check-vultr-model-list
VULTR_EMBEDDING_MODEL=check-vultr-model-list
# Size of the embedding vectors; sets the vector(N) column in the DB.
EMBEDDING_DIM=1024

# --- LangSmith (traces of what the agents did, free tier) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_fake_not_a_real_key
LANGSMITH_PROJECT=prism-dev

# --- Database ---
# Local dev: Docker Postgres (Phase 1, Step 3). Production: Vultr Managed PostgreSQL.
DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism
# Vultr Managed PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@vultr-prod-example.vultrdb.com:16751/prism?sslmode=require

# --- Redis (container: local Docker, or on the Vultr VM) ---
REDIS_URL=redis://localhost:6379/0

# --- Internal services (Phase 1, Step 10 onwards) ---
MCP_SERVER_URL=http://localhost:8001/mcp

# --- Dashboard login (Day 3: Auth.js with GitHub OAuth) ---
# Leave these blank until Day 3.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
