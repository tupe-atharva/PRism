# PRism environment variables (EXAMPLE).
# Copy this file to `.env` and fill in your own real values by hand.
# `.env` is git-ignored. Never commit it, and never paste real secrets into chat.
# Secrets are left blank on purpose. Hosting, database and LLM run on Vultr (docs/ARCHITECTURE.md).

# --- Database ---
# Local dev: Docker Postgres (infra/docker-compose.dev.yml). Shared dev/prod: Vultr Managed PostgreSQL.
DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism
# Vultr example: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# --- Redis (local Docker, or a container on the Vultr VM) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub App ---
GITHUB_APP_ID=
# Path to the downloaded .pem private key. Keep it outside git (./secrets/ is git-ignored).
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem
# The webhook secret set in the GitHub App settings. Any long random string.
GITHUB_WEBHOOK_SECRET=
# smee.io channel that forwards GitHub webhooks to localhost (dev only).
SMEE_URL=

# --- Vultr Serverless Inference (OpenAI-compatible) ---
VULTR_INFERENCE_BASE_URL=
VULTR_INFERENCE_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=
# Size of the embedding vectors; sets the Vector(N) column in the DB.
EMBEDDING_DIM=

# --- MCP tool server ---
MCP_URL=http://localhost:8001/mcp
# Shared token the agents/worker use to call the MCP server.
MCP_SERVICE_TOKEN=

# --- LangSmith (agent traces, free tier) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=prism-dev

# --- Dashboard login (Day 3: Auth.js with the GitHub App's OAuth client) ---
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
